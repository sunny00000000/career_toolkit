# Copy this file to .env and fill in real values.
# Never commit the real .env file -- it's already in .gitignore.

# Get a key at https://aistudio.google.com/app/apikey
# When you create it, restrict it to "Gemini API" only (Google is moving
# toward requiring restricted keys during 2026).
GEMINI_API_KEY=AQ.Ab8RN6IJN_8CLLcmkQ3j0YwUkU50EALmA2JghNYmoNcqh57a-Q

# Check https://ai.google.dev/gemini-api/docs/models for the current
# Pro-tier model id if this one has been retired.
# Gemini 2.5 models (gemini-2.5-pro etc.) shut down 16 Oct 2026 -- don't use those.
GEMINI_MODEL=gemini-3.1-pro-preview

# The single password that gates the dashboard. Pick something long and
# unique -- this is the only thing standing between the open internet and
# your Gemini quota once this is deployed.
APP_PASSWORD=

# Random signing key for session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Usually fine to leave these as-is.
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=10

# Optional: powers the "find matching jobs" + salary estimate feature.
# Free account: https://developer.adzuna.com/signup
# Leave blank to skip this feature entirely -- everything else still works.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code Adzuna searches by default (in, gb, us, au, ca,
# nz, de, fr, pl, br, at, za, sg and others -- check developer.adzuna.com
# for the current list. Ireland and the UAE do not appear to be covered.)
ADZUNA_DEFAULT_COUNTRY=in
